# Configuración de microservicios para staging
REACT_APP_AUTH_API_URL=https://auth-staging.tudominio.com
REACT_APP_PAYMENT_API_URL=https://payment-staging.tudominio.com
REACT_APP_COURSE_API_URL=https://course-staging.tudominio.com
REACT_APP_CONTACT_API_URL=https://contact-staging.tudominio.com
REACT_APP_PORTFOLIO_API_URL=https://portfolio-staging.tudominio.com
REACT_APP_HOME_API_URL=https://home-staging.tudominio.com
REACT_APP_ANALYTICS_API_URL=https://analytics-staging.tudominio.com

# URLs por compatibilidad
REACT_APP_API_URL=https://auth-staging.tudominio.com

# PayPal configuration (usar client ID de sandbox)
REACT_APP_PAYPAL_CLIENT_ID=tu_paypal_client_id_sandbox

# Configuración de entorno
NODE_ENV=staging